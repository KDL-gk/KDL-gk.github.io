page { background: #f0f2f5; font-size: 28rpx; color: #333; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif; }
.btn-primary { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; border: none; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; padding: 24rpx 0; text-align: center; }
.btn-danger { background: #fff; color: #ef4444; border: 2rpx solid #fca5a5; border-radius: 12rpx; font-size: 26rpx; padding: 12rpx 24rpx; }
.section { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.section-title { font-size: 32rpx; font-weight: 600; color: #1e40af; margin-bottom: 24rpx; }
.form-group { margin-bottom: 24rpx; }
.form-group .label { font-size: 26rpx; color: #6b7280; margin-bottom: 8rpx; }
.form-group input, .form-group .picker { border: 2rpx solid #d1d5db; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.form-group input:focus { border-color: #2563eb; }
