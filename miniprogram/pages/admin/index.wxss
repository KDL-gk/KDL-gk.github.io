.container { padding: 24rpx; }
.stats { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.stat-card .num { font-size: 48rpx; font-weight: 700; color: #2563eb; display: block; }
.stat-card .label { font-size: 24rpx; color: #6b7280; }
.user-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #f3f4f6; }
.user-info { flex: 1; }
.user-name { font-weight: 600; font-size: 28rpx; display: block; }
.user-realname { font-size: 24rpx; color: #6b7280; }
.role-badge { padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 500; }
.role-admin { background: #dbeafe; color: #1d4ed8; }
.role-user { background: #f3f4f6; color: #6b7280; }
.user-actions { display: flex; gap: 12rpx; align-items: center; margin-left: 16rpx; }
.action-btn { font-size: 22rpx; color: #2563eb; padding: 8rpx 16rpx; background: #eff6ff; border-radius: 8rpx; }
.action-btn.danger { color: #ef4444; background: #fef2f2; }
.hint { font-size: 22rpx; color: #ccc; }
