.login-page { min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.login-card { background: #fff; border-radius: 32rpx; padding: 60rpx 48rpx; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3); width: 100%; }
.login-header { text-align: center; margin-bottom: 48rpx; }
.login-header .logo { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.login-header .title { font-size: 40rpx; font-weight: 600; color: #1e3a8a; display: block; }
.login-header .sub { font-size: 24rpx; color: #6b7280; display: block; margin-top: 8rpx; }
.form-group { margin-bottom: 28rpx; }
.form-group .label { font-size: 26rpx; color: #374151; font-weight: 500; display: block; margin-bottom: 10rpx; }
.form-group input { width: 100%; padding: 20rpx 24rpx; border: 2rpx solid #d1d5db; border-radius: 16rpx; font-size: 28rpx; box-sizing: border-box; }
.msg { padding: 16rpx 24rpx; border-radius: 12rpx; font-size: 26rpx; margin-bottom: 24rpx; }
.msg.error { background: #fef2f2; color: #dc2626; border: 2rpx solid #fca5a5; }
.msg.success { background: #f0fdf4; color: #16a34a; border: 2rpx solid #86efac; }
.btn-login { width: 100%; padding: 24rpx 0; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; border: none; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; margin-top: 16rpx; }
.footer { display: block; text-align: center; margin-top: 32rpx; font-size: 22rpx; color: #9ca3af; }
