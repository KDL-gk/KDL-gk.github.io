.container { padding: 24rpx; }
.stats-bar { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.stat-item { flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.stat-num { font-size: 48rpx; font-weight: 700; color: #2563eb; display: block; }
.stat-label { font-size: 24rpx; color: #6b7280; }
.toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.toolbar-title { font-size: 34rpx; font-weight: 600; color: #1e3a8a; }
.toolbar-btns { display: flex; gap: 12rpx; }
.btn-new { padding: 14rpx 32rpx; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; border: none; border-radius: 12rpx; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.btn-admin { padding: 14rpx 20rpx; background: rgba(37,99,235,0.1); color: #2563eb; border: none; border-radius: 12rpx; font-size: 28rpx; line-height: 1.5; }
.project-card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); position: relative; overflow: hidden; }
.card-accent { position: absolute; top: 0; left: 0; right: 0; height: 6rpx; background: linear-gradient(90deg, #2563eb, #7c3aed); }
.card-icon { font-size: 56rpx; display: block; margin-bottom: 12rpx; }
.card-title { font-size: 32rpx; font-weight: 600; color: #1e3a8a; display: block; margin-bottom: 12rpx; }
.card-info { font-size: 26rpx; color: #6b7280; line-height: 2; }
.card-info text { display: block; }
.card-actions { display: flex; gap: 16rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid #f3f4f6; }
.btn-enter { flex: 1; padding: 16rpx 0; background: #2563eb; color: #fff; border: none; border-radius: 12rpx; font-size: 26rpx; font-weight: 600; text-align: center; line-height: 1.5; }
.btn-del { padding: 16rpx 24rpx; background: #fff; color: #ef4444; border: 2rpx solid #fca5a5; border-radius: 12rpx; font-size: 26rpx; line-height: 1.5; }
.empty { text-align: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.empty-title { font-size: 34rpx; color: #6b7280; display: block; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #9ca3af; }
.btn-logout { width: 100%; margin-top: 40rpx; padding: 20rpx; background: #f3f4f6; color: #6b7280; border: none; border-radius: 12rpx; font-size: 28rpx; }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal { background: #fff; border-radius: 24rpx; padding: 48rpx; width: 85%; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3); }
.modal-title { font-size: 34rpx; font-weight: 600; color: #1e3a8a; display: block; text-align: center; margin-bottom: 36rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.btn-cancel { flex: 1; padding: 20rpx; background: #f3f4f6; color: #374151; border: none; border-radius: 12rpx; font-size: 28rpx; text-align: center; line-height: 1.5; }
.btn-confirm { flex: 1; padding: 20rpx; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; text-align: center; line-height: 1.5; }
